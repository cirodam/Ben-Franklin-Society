# Federation Registry Deployment Configuration
# Copy this file to .env and update with your values
#
# The federation registry is deployed separately from society servers
# It provides discovery and registration services for all BFS societies

# Docker Hub Configuration (for using published images)
DOCKER_USERNAME=cirodam
VERSION=latest

# Access via IP address (no domain required)
# The federation will be accessible at http://YOUR_SERVER_IP
# Societies should configure their federation URL as: http://YOUR_SERVER_IP
