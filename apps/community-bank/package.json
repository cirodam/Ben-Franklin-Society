{
  "name": "@bfs/community-bank",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "seed": "DATABASE_PATH=${DATABASE_PATH:-./bank.sqlite} GOVERNANCE_URL=${GOVERNANCE_URL:-http://localhost:5173} tsx scripts/seed.ts",
    "reset": "bash scripts/reset.sh",
    "scheduler": "DATABASE_PATH=${DATABASE_PATH:-./bank.sqlite} GOVERNANCE_URL=${GOVERNANCE_URL:-http://localhost:5173} tsx scripts/run-scheduler.ts"
  },
  "dependencies": {
    "@bfs/db": "workspace:*",
    "@bfs/events": "workspace:*",
    "@bfs/oidc-client": "workspace:*",
    "@bfs/types": "workspace:*",
    "@bfs/ui": "workspace:*",
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^25.6.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  }
}
