# Docker Deployment Configuration
# Copy this file to .env and update with your values

# Docker Hub Configuration (for using published images)
# Uncomment these to use published images instead of building locally
# DOCKER_USERNAME=benfranklinsociety
# VERSION=latest

# Domain Configuration
GOVERNANCE_DOMAIN=governance.bfs.example.com
BANK_DOMAIN=bank.bfs.example.com
MAIL_DOMAIN=mail.bfs.example.com
MARKETPLACE_DOMAIN=marketplace.bfs.example.com

# Public URLs (used for OIDC redirects)
GOVERNANCE_URL=https://governance.bfs.example.com
BANK_URL=https://bank.bfs.example.com
MAIL_URL=https://mail.bfs.example.com
MARKETPLACE_URL=https://marketplace.bfs.example.com

# Let's Encrypt Configuration
ACME_EMAIL=admin@bfs.example.com

# OIDC Client Secrets (generate with: openssl rand -hex 32)
BANK_OIDC_SECRET=your-secret-here
MAIL_OIDC_SECRET=your-secret-here
MARKETPLACE_OIDC_SECRET=your-secret-here
